#!/usr/bin/env python3
"""Tokalator Glossary — Codebase symbol index generator for Claude Code."""
from __future__ import annotations

import ast
import json
import sys
from pathlib import Path

SKIP_DIRS = {
    ".venv", "venv", "node_modules", ".git", "__pycache__", ".next",
    "dist", "build", ".tox", ".mypy_cache", "env", ".egg-info",
}
SUPPORTED = {".py", ".js", ".ts", ".tsx", ".jsx"}


def extract_python(path: Path) -> list[dict]:
    try:
        tree = ast.parse(path.read_text(encoding="utf-8"))
    except (SyntaxError, UnicodeDecodeError):
        return []

    symbols: list[dict] = []
    for node in ast.walk(tree):
        match node:
            case ast.ClassDef(name=name):
                bases = [getattr(b, "id", "?") for b in node.bases]
                symbols.append({
                    "type": "class", "name": name, "file": str(path),
                    "line": node.lineno,
                    "info": f"extends {', '.join(bases)}" if bases else "",
                })
            case ast.FunctionDef(name=name) | ast.AsyncFunctionDef(name=name):
                is_async = isinstance(node, ast.AsyncFunctionDef)
                args = [a.arg for a in node.args.args if a.arg != "self"]
                prefix = "async " if is_async else ""
                symbols.append({
                    "type": f"{prefix}function", "name": name, "file": str(path),
                    "line": node.lineno, "info": f"({', '.join(args)})",
                })
    return symbols


def extract_js(path: Path) -> list[dict]:
    symbols: list[dict] = []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except UnicodeDecodeError:
        return []

    for i, line in enumerate(lines, 1):
        stripped = line.strip()
        if stripped.startswith(("export function ", "export async function ")):
            name = stripped.split("function ")[1].split("(")[0].strip()
            symbols.append({"type": "function", "name": name, "file": str(path), "line": i, "info": "export"})
        elif stripped.startswith("export const "):
            name = stripped.split("export const ")[1].split("=")[0].split(":")[0].strip()
            symbols.append({"type": "const", "name": name, "file": str(path), "line": i, "info": "export"})
        elif stripped.startswith("export class "):
            name = stripped.split("export class ")[1].split("{")[0].split("(")[0].strip()
            symbols.append({"type": "class", "name": name, "file": str(path), "line": i, "info": "export"})
        elif stripped.startswith("export default "):
            symbols.append({"type": "default", "name": "default", "file": str(path), "line": i, "info": "export default"})
    return symbols


EXTRACTORS = {
    ".py": extract_python, ".js": extract_js,
    ".ts": extract_js, ".tsx": extract_js, ".jsx": extract_js,
}


def scan(root: Path) -> list[dict]:
    symbols: list[dict] = []
    for path in sorted(root.rglob("*")):
        if any(s in path.parts for s in SKIP_DIRS):
            continue
        if path.suffix in EXTRACTORS:
            symbols.extend(EXTRACTORS[path.suffix](path))
    return symbols


def build_glossary(root: Path) -> str:
    symbols = scan(root)
    if not symbols:
        return "# Codebase Glossary\n\nNo symbols found. Run after adding code.\n"

    by_file: dict[str, list[dict]] = {}
    for s in symbols:
        rel = str(Path(s["file"]).relative_to(root))
        by_file.setdefault(rel, []).append(s)

    type_counts: dict[str, int] = {}
    for s in symbols:
        type_counts[s["type"]] = type_counts.get(s["type"], 0) + 1

    lines = [
        "# Codebase Glossary",
        "",
        f"> Auto-generated by tokalator-glossary — {len(symbols)} symbols across {len(by_file)} files",
        "",
        "## Summary",
        "",
        "| Type | Count |",
        "|------|-------|",
    ]
    for t, c in sorted(type_counts.items()):
        lines.append(f"| {t} | {c} |")

    lines += ["", "---", ""]

    for file_path in sorted(by_file):
        lines.append(f"## `{file_path}`")
        lines.append("")
        lines.append("| Type | Name | Line | Info |")
        lines.append("|------|------|------|------|")
        for s in sorted(by_file[file_path], key=lambda x: x["line"]):
            lines.append(f"| {s['type']} | `{s['name']}` | L{s['line']} | {s.get('info', '')} |")
        lines.append("")

    return "\n".join(lines)


def build_json(root: Path) -> str:
    symbols = scan(root)
    for s in symbols:
        s["file"] = str(Path(s["file"]).relative_to(root))
    return json.dumps(symbols, indent=2)


def main():
    import argparse
    parser = argparse.ArgumentParser(description="Tokalator Glossary — generate codebase symbol index")
    parser.add_argument("root", nargs="?", default=".", help="Project root directory")
    parser.add_argument("--format", choices=["markdown", "json"], default="markdown")
    parser.add_argument("--output", "-o", help="Output file (default: GLOSSARY.md)")
    args = parser.parse_args()

    root = Path(args.root).resolve()
    if not root.is_dir():
        print(f"Error: {root} is not a directory", file=sys.stderr)
        sys.exit(1)

    if args.format == "json":
        result = build_json(root)
        default_out = "glossary.json"
    else:
        result = build_glossary(root)
        default_out = "GLOSSARY.md"

    output = Path(args.output) if args.output else root / default_out
    output.write_text(result, encoding="utf-8")
    print(f"Tokalator Glossary: {output} ({len(result):,} chars)")


if __name__ == "__main__":
    main()
